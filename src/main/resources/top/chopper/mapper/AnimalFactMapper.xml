<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="top.chopper.mapper.AnimalFactMapper">

    <select id="getRandomByType" resultType="top.chopper.pojo.AnimalFact">
        select * from animal_fact where `type` = #{type} order by RAND() limit 1
    </select>
</mapper>